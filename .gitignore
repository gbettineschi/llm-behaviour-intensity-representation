# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Experiment outputs
output/

# Secrets
.env


.DS_Store
CLAUDE.md
.claude
.vscode

activations/

# Model representations: every layer of every model/trait lives on the Hugging
# Face Hub, fetched with src/data_sync.py and pinned by representations.lock.json.
# This replaces the previous focal-layer-only policy, which existed solely to fit
# Git's size limits and cost us full layer sweeps for all but two model/trait combos.
data/**/representations/**/*.pt

# huggingface_hub download cache created by src/data_sync.py pull
# (the library writes its own .gitignore in here too; this makes the intent explicit)
data/.cache/

# Per-seed analysis dumps - regenerate byte-identically by re-running the same seed
results/**/seed_*/

# Figures. Each one renders the numeric export sitting next to it, so it holds
# strictly less information than a file we already track, and "Binary files
# differ" is not a review signal. A manuscript that needs a figure should copy
# the one it uses into wherever the manuscript lives; reaching into this tree is
# what made 56 PNGs churn on every re-run.
results/**/*.png
